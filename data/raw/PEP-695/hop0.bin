            <div class="email-author d-flex">
                <h2 class="name">
                    
                    <a href="/archives/users/fd91b094676d4d888d16893a47b843e8/"
                       title="See the profile for Eric Traut"
                       >Eric Traut</a>
                    
                </h2>
