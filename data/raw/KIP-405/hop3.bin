g/jira/secure/useravatar?size=small&ownerId=showuon&avatarId=42594","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=showuon&avatarId=42594","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=showuon&avatarId=42594"},"displayName":"Luke Chen","active":true,"timeZone":"Etc/UTC"},"body":"[~twmb] , we already use -4 to indicate the earliest log start offset (local log start offset). Thanks.","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=showuon","name":"showuon","key":"showuon","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=showuon&avatarId=42594","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=showuon&avatarId=42594","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=showuon&avatarId=42594","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=showuon&avatarId=42594"},"displayName":"Luke Chen","active":true,"timeZone":"Etc/UTC"},"created":"2023-03-29T06:42:19.382+0000","updated":"2023-03-29T06:42:19.382+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17706496","id":"17706496","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=twmb","name":"twmb","key":"twmb","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=34059","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=34059","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=34059","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=34059"},"displayName":"Travis Bischel","active":true,"timeZone":"Etc/UTC"},"body":"[~showuon] thanks. How does that affect the KIP? If I'm to use the KIP as a client author, currently, I'll implement something incorrectly.","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=twmb","name":"twmb","key":"twmb","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=34059","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=34059","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=34059","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=34059"},"displayName":"Travis Bischel","active":true,"timeZone":"Etc/UTC"},"created":"2023-03-29T16:03:24.974+0000","updated":"2023-03-29T16:03:24.974+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17710971","id":"17710971","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=satish.duggana","name":"satish.duggana","key":"satish.duggana","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Satish Duggana","active":true,"timeZone":"Asia/Kolkata"},"body":"[~twmb] KIP is updated with the right value for earliest local log start offset. Thanks.","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=satish.duggana","name":"satish.duggana","key":"satish.duggana","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Satish Duggana","active":true,"timeZone":"Asia/Kolkata"},"created":"2023-04-11T14:00:53.222+0000","updated":"2023-04-11T14:00:53.222+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17712586","id":"17712586","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=hcai%40pinterest.com","name":"hcai@pinterest.com","key":"hcai@pinterest.com","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Henry Cai","active":true,"timeZone":"Etc/UTC"},"body":"[~satish.duggana] I saw this KIP is moved out of [3.5.0 release plan |[https://cwiki.apache.org/confluence/display/KAFKA/Release+Plan+3.5.0]], will any of 30ish resolved subtasks/fixes in this KIP appear in 3.5.0 branch?","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=hcai%40pinterest.com","name":"hcai@pinterest.com","key":"hcai@pinterest.com","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Henry Cai","active":true,"timeZone":"Etc/UTC"},"created":"2023-04-15T00:41:25.586+0000","updated":"2023-04-15T00:41:25.586+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17712816","id":"17712816","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=satish.duggana","name":"satish.duggana","key":"satish.duggana","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Satish Duggana","active":true,"timeZone":"Asia/Kolkata"},"body":"[~hcai@pinterest.com] Some of the JIRAs that were done in 3.5 and a couple of them are in progress/review.\r\n\r\nhttps://issues.apache.org/jira/browse/KAFKA-9550 \r\nhttps://issues.apache.org/jira/browse/KAFKA-14466 \r\nhttps://issues.apache.org/jira/browse/KAFKA-14495 \r\nhttps://issues.apache.org/jira/browse/KAFKA-14685 \r\nhttps://issues.apache.org/jira/browse/KAFKA-14850\r\n\r\nWe are working on having an early access build in ~6-7 weeks time. ","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=satish.duggana","name":"satish.duggana","key":"satish.duggana","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Satish Duggana","active":true,"timeZone":"Asia/Kolkata"},"created":"2023-04-16T16:55:28.896+0000","updated":"2023-04-16T17:10:54.908+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17720936","id":"17720936","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=jeqo","name":"jeqo","key":"jeqo","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=jeqo&avatarId=52728","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jeqo&avatarId=52728","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=jeqo&avatarId=52728","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=jeqo&avatarId=52728"},"displayName":"Jorge Esteban Quilcate Otoya","active":true,"timeZone":"Europe/Helsinki"},"body":"[~satish.duggana] could you help clarifying the following:\r\n\r\nRemoteStorageManager#fetchIndex and RemoteStorageManager#fetchLogSegment state:\r\n\r\n>      * @throws RemoteResourceNotFoundException when there are no resources associated with the given remoteLogSegmentMetadata.\r\n\r\nThough when fetching indexes: Transactional Index is optional. So when returning a response should it be null? or throw RemoteResourceNotFoundException?\r\n\r\nFrom the javadoc is unclear whether resources means a specific object/index or the whole segment log + metadata.","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=jeqo","name":"jeqo","key":"jeqo","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=jeqo&avatarId=52728","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jeqo&avatarId=52728","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=jeqo&avatarId=52728","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=jeqo&avatarId=52728"},"displayName":"Jorge Esteban Quilcate Otoya","active":true,"timeZone":"Europe/Helsinki"},"created":"2023-05-09T13:42:43.159+0000","updated":"2023-05-09T13:42:43.159+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17720947","id":"17720947","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=adupriez","name":"adupriez","key":"adupriez","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=adupriez&avatarId=41782","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=adupriez&avatarId=41782","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=adupriez&avatarId=41782","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=adupriez&avatarId=41782"},"displayName":"Alexandre Dupriez","active":true,"timeZone":"Europe/London"},"body":"I would think that the absence of the log segment or any mandatory ancillary file results in the stated exception. I think only transaction indexes are optional.","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=adupriez","name":"adupriez","key":"adupriez","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=adupriez&avatarId=41782","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=adupriez&avatarId=41782","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=adupriez&avatarId=41782","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=adupriez&avatarId=41782"},"displayName":"Alexandre Dupriez","active":true,"timeZone":"Europe/London"},"created":"2023-05-09T14:04:44.860+0000","updated":"2023-05-09T14:04:44.860+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17720955","id":"17720955","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=jeqo","name":"jeqo","key":"jeqo","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=jeqo&avatarId=52728","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jeqo&avatarId=52728","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=jeqo&avatarId=52728","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=jeqo&avatarId=52728"},"displayName":"Jorge Esteban Quilcate Otoya","active":true,"timeZone":"Europe/Helsinki"},"body":"Yes, we know transactional index is optional when copying but not when fetching. I agree throwing the exception should be correct, but the javadoc is ambiguous as it refers to \"no resources associated with the given remoteLogSegmentMetadata\" that may mean _all_ resources, instead of \"the requested resource is not found in the remote storage\" or similar.","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=jeqo","name":"jeqo","key":"jeqo","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=jeqo&avatarId=52728","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jeqo&avatarId=52728","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=jeqo&avatarId=52728","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=jeqo&avatarId=52728"},"displayName":"Jorge Esteban Quilcate Otoya","active":true,"timeZone":"Europe/Helsinki"},"created":"2023-05-09T15:00:15.534+0000","updated":"2023-05-09T15:00:15.534+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17721025","id":"17721025","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=adupriez","name":"adupriez","key":"adupriez","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=adupriez&avatarId=41782","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=adupriez&avatarId=41782","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=adupriez&avatarId=41782","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=adupriez&avatarId=41782"},"displayName":"Alexandre Dupriez","active":true,"timeZone":"Europe/London"},"body":"Got it. Sorry I misunderstood your suggestion. Thanks for clarifying! (and agree with it).","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=adupriez","name":"adupriez","key":"adupriez","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=adupriez&avatarId=41782","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=adupriez&avatarId=41782","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=adupriez&avatarId=41782","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=adupriez&avatarId=41782"},"displayName":"Alexandre Dupriez","active":true,"timeZone":"Europe/London"},"created":"2023-05-09T17:33:36.957+0000","updated":"2023-05-09T17:33:36.957+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17722119","id":"17722119","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=satish.duggana","name":"satish.duggana","key":"satish.duggana","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Satish Duggana","active":true,"timeZone":"Asia/Kolkata"},"body":"[~jeqo] \r\n\r\nGood point, we can improve the javadoc about the TransactionIndex case also in RSM.\r\n\r\nFiled https://issues.apache.org/jira/browse/KAFKA-14993 ","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=satish.duggana","name":"satish.duggana","key":"satish.duggana","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Satish Duggana","active":true,"timeZone":"Asia/Kolkata"},"created":"2023-05-12T11:13:19.155+0000","updated":"2023-05-14T02:19:32.271+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17722129","id":"17722129","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=showuon","name":"showuon","key":"showuon","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=showuon&avatarId=42594","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=showuon&avatarId=42594","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=showuon&avatarId=42594","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=showuon&avatarId=42594"},"displayName":"Luke Chen","active":true,"timeZone":"Etc/UTC"},"body":"Good catch! Thanks all!","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=showuon","name":"showuon","key":"showuon","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=showuon&avatarId=42594","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=showuon&avatarId=42594","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=showuon&avatarId=42594","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=showuon&avatarId=42594"},"displayName":"Luke Chen","active":true,"timeZone":"Etc/UTC"},"created":"2023-05-12T11:30:46.830+0000","updated":"2023-05-12T11:30:46.830+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17722747","id":"17722747","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=jeqo","name":"jeqo","key":"jeqo","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=jeqo&avatarId=52728","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jeqo&avatarId=52728","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=jeqo&avatarId=52728","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=jeqo&avatarId=52728"},"displayName":"Jorge Esteban Quilcate Otoya","active":true,"timeZone":"Europe/Helsinki"},"body":"Thanks all!\r\n\r\nAnother question regarding copy/delete RSM operations: I couldn't found any expectation on idempotency for these operations.\r\n\r\n`copyLogSegmentData` mentions something related:\r\n\r\n> Invoker of this API should always send a unique id as part of \\{@link RemoteLogSegmentMetadata#remoteLogSegmentId()} even when it retries to invoke this method for the same log segment data.\r\n\r\nThough this only confirms that retries will contain the same id.\r\n\r\n`deleteLogSegmentData` is more ambiguous:\r\n\r\n> Deletion is considered as successful if this call returns successfully without any errors.\r\n\r\nbut\r\n\r\n> RemoteResourceNotFoundException if the requested resource is not found\r\n\r\nSo, if retried should it fail?\r\n\r\nMy guess is that both should be idempotent, but could be worth call out these expectations explicitly in the KIP/API.","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=jeqo","name":"jeqo","key":"jeqo","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=jeqo&avatarId=52728","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jeqo&avatarId=52728","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=jeqo&avatarId=52728","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=jeqo&avatarId=52728"},"displayName":"Jorge Esteban Quilcate Otoya","active":true,"timeZone":"Europe/Helsinki"},"created":"2023-05-15T11:25:26.341+0000","updated":"2023-05-15T11:25:26.341+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17727229","id":"17727229","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=hcai%40pinterest.com","name":"hcai@pinterest.com","key":"hcai@pinterest.com","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Henry Cai","active":true,"timeZone":"Etc/UTC"},"body":"[~satish.duggana] It was mentioned that at the end of May, we will have an early access build to test the tiered storage feature, is that build getting close?","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=hcai%40pinterest.com","name":"hcai@pinterest.com","key":"hcai@pinterest.com","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Henry Cai","active":true,"timeZone":"Etc/UTC"},"created":"2023-05-30T01:02:18.964+0000","updated":"2023-05-30T01:02:18.964+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17735197","id":"17735197","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=jeqo","name":"jeqo","key":"jeqo","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=jeqo&avatarId=52728","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jeqo&avatarId=52728","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=jeqo&avatarId=52728","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=jeqo&avatarId=52728"},"displayName":"Jorge Esteban Quilcate Otoya","active":true,"timeZone":"Europe/Helsinki"},"body":"[~satish.duggana] I remember a follow up PR related to remote fetching: [https://github.com/apache/kafka/pull/13535#discussion_r1171250580]\r\n\r\nThinking about 3.6 release, are these improvement going to be considered? Also, do we have a Jira ticket to track it?\r\n\r\nMany thanks!","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=jeqo","name":"jeqo","key":"jeqo","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=jeqo&avatarId=52728","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jeqo&avatarId=52728","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=jeqo&avatarId=52728","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=jeqo&avatarId=52728"},"displayName":"Jorge Esteban Quilcate Otoya","active":true,"timeZone":"Europe/Helsinki"},"created":"2023-06-20T09:14:38.559+0000","updated":"2023-06-20T09:14:38.559+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17735221","id":"17735221","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=showuon","name":"showuon","key":"showuon","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=showuon&avatarId=42594","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=showuon&avatarId=42594","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=showuon&avatarId=42594","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=showuon&avatarId=42594"},"displayName":"Luke Chen","active":true,"timeZone":"Etc/UTC"},"body":"[~jeqo] , please open a JIRA and welcome to contribute on it. Thank you.","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=showuon","name":"showuon","key":"showuon","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=showuon&avatarId=42594","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=showuon&avatarId=42594","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=showuon&avatarId=42594","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=showuon&avatarId=42594"},"displayName":"Luke Chen","active":true,"timeZone":"Etc/UTC"},"created":"2023-06-20T10:01:29.597+0000","updated":"2023-06-20T10:01:29.597+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17735299","id":"17735299","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=jeqo","name":"jeqo","key":"jeqo","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=jeqo&avata