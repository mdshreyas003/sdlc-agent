            <div class='post' itemprop="text">
              <aside class="quote group-committers" data-username="gpshead" data-post="4" data-topic="21331">
<div class="title">
<div class="quote-controls"></div>
<img loading="lazy" alt="" width="24" height="24" src="https://sea2.discourse-cdn.com/flex016/user_avatar/discuss.python.org/gpshead/48/54_2.png" class="avatar"> Gregory P. Smith:</div>
