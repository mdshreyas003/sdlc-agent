            <div class="gravatar circle">
                <img class="gravatar" src="https://secure.gravatar.com/avatar/01aa7d6d4db83982a2f6dd363d0ee0f3.jpg?s=120&amp;d=mm&amp;r=g" width="120" height="120" alt="" />
            </div>
            <div class="email-author d-flex">
                <h2 class="name">
                    
                    <a href="/archives/users/e314ca6c5b724588915063991408c134/"
