        <div id="topic-title">
    <h1>
      <a href="/t/pep-695-type-parameter-syntax/21646">PEP 695: Type Parameter Syntax</a>
    </h1>

      <div class="topic-category" itemscope itemtype="http://schema.org/BreadcrumbList">
