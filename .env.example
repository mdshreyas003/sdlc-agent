# Copy to .env. Never commit .env.
# Only Neo4j is required here: GitHub/Jira/Slack/AI-model keys are entered per workspace in the UI.
# Everything below the Neo4j block is an optional environment FALLBACK for keys not saved in a workspace.
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hackfront-dev
NEO4J_DATABASE=neo4j

# Where workspaces, saved keys and investigations are kept: "file" (default: local .hackfront/ folder) or "neo4j"
# (stateless hosting). "neo4j" also needs HACKFRONT_SECRET_KEY: any long random string; it encrypts API keys saved in
# the UI. Copy local state across with: uv run hackfront migrate-state
HACKFRONT_STATE=file
HACKFRONT_SECRET_KEY=
# Public API only: require this bearer token on every /api call (the Vercel proxy adds it)
HACKFRONT_ACCESS_TOKEN=

# Accounts (GitHub OAuth). Leave the client id/secret empty for the local single-user mode (everything runs as "local").
# Create an OAuth app at github.com/settings/developers with callback  <HACKFRONT_PUBLIC_URL>/api/auth/github/callback
# HACKFRONT_SECRET_KEY (above) signs the session cookie, so it is required once sign-in is on.
# HACKFRONT_AUTH: off = force sign-in off; password = also allow email + password accounts (needs HACKFRONT_SECRET_KEY;
# no self-service reset, use `hackfront set-password <email>`); required = refuse to run open when no method is set up.
# The first account ever created (either method) takes ownership of workspaces that predate accounts.
# On a PUBLIC deployment set an allowlist, otherwise anyone who finds the URL can create an account (and the first one
# claims the existing workspaces): HACKFRONT_ALLOWED_EMAILS=you@x.com,@yourcompany.com  HACKFRONT_ALLOWED_GITHUB=you,colleague
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# The browser-facing origin of the web app (where /api/* is proxied), e.g. http://localhost:3000
HACKFRONT_PUBLIC_URL=
HACKFRONT_AUTH=

# LLM. Any OpenAI-compatible chat-completions endpoint (OpenAI, Azure OpenAI /openai/v1/, Sarvam, OpenRouter,
# vLLM, Ollama, LM Studio, ...). LLM_PROVIDER: openai | azure | sarvam; empty = first configured provider.
# Generic provider ("openai"): environment only, never stored per workspace.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Empty = https://api.openai.com/v1. Examples: https://openrouter.ai/api/v1, http://localhost:11434/v1 (Ollama),
# https://<resource>.openai.azure.com/openai/v1/, https://api.sarvam.ai/v1/
LLM_BASE_URL=
# Request timeout in seconds (default 180)
LLM_TIMEOUT=
# Output-token limit per call (default 16000) and the argument name that carries it: max_tokens (default) or
# max_completion_tokens (OpenAI reasoning models)
LLM_MAX_TOKENS=
LLM_MAX_TOKENS_PARAM=
# Legacy presets (still supported; may also be saved per workspace in the UI). LLM_MODEL overrides their default
# model (azure: Kimi-K2.5, sarvam: sarvam-105b) when that preset is the default provider.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
SARVAM_API_KEY=

# Sources (only needed for live sync; demo mode needs none)
GITHUB_TOKEN=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=
