e.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Evan Williams","active":true,"timeZone":"Etc/UTC"},"body":"Great work [~satish.duggana] . However, will this make 3.6.0 ? I see the feature freeze is 16th August for that release. ","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=blodsbror","name":"blodsbror","key":"blodsbror","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Evan Williams","active":true,"timeZone":"Etc/UTC"},"created":"2023-09-15T08:30:35.815+0000","updated":"2023-09-15T08:30:35.815+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17765502","id":"17765502","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=showuon","name":"showuon","key":"showuon","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?ownerId=showuon&avatarId=42594","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=showuon&avatarId=42594","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=showuon&avatarId=42594","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=showuon&avatarId=42594"},"displayName":"Luke Chen","active":true,"timeZone":"Etc/UTC"},"body":"This will be included in v3.6.0, and be considered as an early access feature. It's not recommended to run in the production environment.","updateAuthor":{"self":"https://issues.apa