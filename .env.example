# Copy to .env. Never commit .env.
# Only Neo4j is required here: GitHub/Jira/Slack/AI-model keys are entered per workspace in the UI.
# Everything below the Neo4j block is an optional environment FALLBACK for keys not saved in a workspace.
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hackfront-dev
NEO4J_DATABASE=neo4j

# Where workspaces, saved keys and investigations are kept: "file" (default: local .hackfront/ folder) or "neo4j"
# (stateless hosting). "neo4j" also needs HACKFRONT_SECRET_KEY: any long random string; it encrypts API keys saved in
# the UI. Copy local state across with: uv run hackfront migrate-state
HACKFRONT_STATE=file
HACKFRONT_SECRET_KEY=
# Public API only: require this bearer token on every /api call (the Vercel proxy adds it)
HACKFRONT_ACCESS_TOKEN=

# LLM. Any OpenAI-compatible chat-completions endpoint (OpenAI, Azure OpenAI /openai/v1/, Sarvam, OpenRouter,
# vLLM, Ollama, LM Studio, ...). LLM_PROVIDER: openai | azure | sarvam; empty = first configured provider.
# Generic provider ("openai"): environment only, never stored per workspace.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Empty = https://api.openai.com/v1. Examples: https://openrouter.ai/api/v1, http://localhost:11434/v1 (Ollama),
# https://<resource>.openai.azure.com/openai/v1/, https://api.sarvam.ai/v1/
LLM_BASE_URL=
# Request timeout in seconds (default 180)
LLM_TIMEOUT=
# Legacy presets (still supported; may also be saved per workspace in the UI). LLM_MODEL overrides their default
# model (azure: Kimi-K2.5, sarvam: sarvam-105b) when that preset is the default provider.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
SARVAM_API_KEY=

# Sources (only needed for live sync; demo mode needs none)
GITHUB_TOKEN=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=
