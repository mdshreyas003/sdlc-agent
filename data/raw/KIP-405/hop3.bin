.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Konstantine Karantasis","active":true,"timeZone":"America/Los_Angeles"},"created":"2021-07-08T05:48:27.785+0000","updated":"2021-07-08T05:48:27.785+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17378276","id":"17378276","author":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=kkonstantine","name":"kkonstantine","key":"kkonstantine","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Konstantine Karantasis","active":true,"timeZone":"America/Los_Angeles"},"body":"Setting the target version of this feature to the next AK release (currently 3.1.0) since there are still essential parts of the implementation that haven't landed before feature freeze for 3.0","updateAuthor":{"self":"https://issues.apache.org/jira/rest/api/2/user?username=kkonstantine","name":"kkonstantine","key":"kkonstantine","avatarUrls":{"48x48":"https://issues.apache.org/jira/secure/useravatar?avatarId=10452","24x24":"https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452","16x16":"https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452","32x32":"https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"},"displayName":"Konstantine Karantasis","active":true,"timeZone":"America/Los_Angeles"},"created":"2021-07-09T20:27:32.911+0000","updated":"2021-07-09T20:27:32.911+0000"},{"self":"https://issues.apache.org/jira/rest/api/2/issue/13204565/comment/17437338","id":"17437338","author":{"self":"https://issues.apache.org/jira/rest/api/2/