        <div id="topic-title">
    <h1>
      <a href="/t/pep-649-deferred-evaluation-of-annotations-tentatively-accepted/21331">PEP 649: Deferred evaluation of annotations, tentatively accepted</a>
    </h1>

      <div class="topic-category" itemscope itemtype="http://schema.org/BreadcrumbList">
