{
  "mcpServers": {
    "why": {
      "command": "uv",
      "args": ["run", "--directory", "/path/to/sdlc-agent", "hackfront", "mcp", "--workspace", "brightcart"],
      "env": {
        "NEO4J_URI": "bolt://localhost:7690",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "<your-neo4j-password>",
        "NEO4J_DATABASE": "neo4j",
        "HACKFRONT_HOME": "/path/to/your/hackfront-home"
      }
    }
  }
}
