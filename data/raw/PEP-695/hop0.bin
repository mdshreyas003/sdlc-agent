<div class="email email-first">

    <div id="BB2BGYJY2YG5IWESKGTAPUQL3N27ZKVW" class="email-header">
        <div class="gravatar-wrapper d-flex">
            <div class="gravatar circle">
                <img class="gravatar" src="https://secure.gravatar.com/avatar/3247bfd67c8fa4c4a08b8d30e49eab39.jpg?s=120&amp;d=mm&amp;r=g" width="120" height="120" alt="" />
