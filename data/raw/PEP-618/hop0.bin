        <div class="col-10">
            <h1>[Python-Dev] Accepting PEP 618: zip(strict=True)</h1>
        </div>
        </div>

        <div class="row">
            <div class="col-lg-9">
                <section id="thread-content">
                    





<div class="email email-first">

    <div id="NLWB7FVJGMBBMCF4P3ZKUIE53JPDOWJ3" class="email-header">
        <div class="gravatar-wrapper d-flex">
            <div class="gravatar circle">
                <img class="gravatar" src="https://secure.gravatar.com/avatar/047f2332cde3730f1ed661eebb0c5686.jpg?s=120&amp;d=mm&amp;r=g" width="120" height="120" alt="" />
            </div>
            <div class="email-author d-flex">
