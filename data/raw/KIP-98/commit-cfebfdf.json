/kafka/commits/f1dd0d272313deceaf7021e54c09a63043acf4af","html_url":"https://github.com/apache/kafka/commit/f1dd0d272313deceaf7021e54c09a63043acf4af"}],"stats":{"total":4,"additions":3,"deletions":1},"files":[{"sha":"c76ff2a53223aacfcf1c8abad1e8c4393c63a1ce","filename":"build.gradle","status":"modified","additions":3,"deletions":1,"changes":4,"blob_url":"https://github.com/apache/kafka/blob/cfebfdfa5e537946e4c6e1cc986f20131899be31/build.gradle","raw_url":"https://github.com/apache/kafka/raw/cfebfdfa5e537946e4c6e1cc986f20131899be31/build.gradle","contents_url":"https://api.github.com/repos/apache/kafka/contents/build.gradle?ref=cfebfdfa5e537946e4c6e1cc986f20131899be31","patch":"@@ -677,7 +677,7 @@ project(':streams') {\n   dependencies {\n     compile project(':clients')\n     compile project(':connect:json')  // this dependency should be removed after we unify data API\n-    compile libs.slf4jlog4j\n+    compile libs.slf4jApi\n     compile libs.rocksDBJni\n     // this dependency should be removed after KIP-4\n     compile (libs.zkclient) {\n@@ -690,6 +690,8 @@ project(':streams') {\n     testCompile project(':core')\n     testCompile project(':core').sourceSets.test.output\n     testCompile libs.junit\n+\n+    testRuntime libs.slf4jlog4j\n   }\n \n   javadoc {"}]}